{
	"schemaVersion": 1,
	"name": "open-question-calibration-v1",
	"description": "Labelled cases for the open_question signal. Text is synthetic, written to mirror the shapes measured in a real index: the dominant population is ordinary conversational questions carrying nothing but a bare `?`, which should not be reported as open questions. Labels are editorial judgements about what an agent should be told is unresolved, not ground truth harvested from real threads.",
	"cases": [
		{
			"id": "chatter-answered",
			"note": "Ordinary question, answered in thread. Not open.",
			"posts": [
				{ "id": "p1", "author": "alice", "message": "заведёшь баг?" },
				{ "id": "p2", "author": "bob", "message": "да, уже завёл" }
			],
			"expectedOpenQuestions": [],
			"expectPurposeHint": false
		},
		{
			"id": "chatter-tail-unanswered",
			"note": "The dominant real shape: a throwaway question that simply ended the conversation. `unanswered` here means nobody spoke after, not that anything is pending.",
			"posts": [
				{ "id": "p1", "author": "alice", "message": "деплой прошёл?" },
				{ "id": "p2", "author": "bob", "message": "ага" },
				{ "id": "p3", "author": "alice", "message": "получилось черкануть ?" }
			],
			"expectedOpenQuestions": [],
			"expectPurposeHint": false
		},
